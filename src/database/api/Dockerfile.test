FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY src/database/api/requirements.txt /tmp/requirements.txt
COPY src/database/api/requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt

CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "src/database/api/tests"]
